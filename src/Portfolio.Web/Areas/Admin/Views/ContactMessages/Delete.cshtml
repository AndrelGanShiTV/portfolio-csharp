@model ContactMessageAdminViewModel

@{
    ViewData["Title"] = "Eliminar mensaje";
}

<div class="container py-5">
    <h1 class="text-danger">Eliminar mensaje</h1>

    <p>
        ¿Seguro que quieres eliminar el mensaje de
        <strong>@Model.Name</strong>
        con asunto
        <strong>@Model.Subject</strong>?
    </p>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">

        <button type="submit" class="btn btn-danger">
            Sí, eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>