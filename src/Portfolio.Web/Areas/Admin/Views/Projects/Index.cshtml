@model IEnumerable<ProjectCardViewModel>

@{
    ViewData["Title"] = "Administrar proyectos";
}

<div class="container py-5">
    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        Volver al panel
    </a>

    <div class="d-flex justify-content-between mb-4">
        <h1>Administrar proyectos</h1>

        <a asp-area="Admin" asp-controller="Projects" asp-action="Create" class="btn btn-primary">Nuevo proyecto</a>

    </div>

    @foreach (var project in Model)
    {
        <div class="card mb-3">
            <div class="card-body">

                <h5 class="card-title">@project.Name</h5>

                @if (project.IsPublished)
                {
                    <span class="badge text-bg-success">Publicado</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Borrador</span>
                }

                <a asp-area="Admin" asp-controller="Projects" asp-action="Edit" asp-route-id="@project.Id"
                   class="btn btn-warning">
                    Editar
                </a>

                <a asp-area="Admin" asp-controller="Projects" asp-action="Delete" asp-route-id="@project.Id"
                   class="btn btn-danger">
                    Eliminar
                </a>

            </div>
        </div>
    }

</div>