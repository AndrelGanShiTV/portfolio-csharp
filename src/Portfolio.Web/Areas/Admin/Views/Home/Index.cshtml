@{
    ViewData["Title"] = "Panel administrativo";
}

<div class="container py-5">
    <div class="mb-4">
        <h1>Panel administrativo</h1>
        <p class="text-muted">
            Administra el contenido del portafolio.
        </p>
    </div>


    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Proyectos</h2>
                    <p class="text-muted">
                        Crea, edita y publica proyectos.
                    </p>

                    <a asp-area="Admin" asp-controller="Projects" asp-action="Index" class="btn btn-primary">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Tecnologías</h2>
                    <p class="text-muted">
                        Administra las skills del portafolio.
                    </p>

                    <a asp-area="Admin" asp-controller="Skills" asp-action="Index" class="btn btn-primary">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Experiencia</h2>
                    <p class="text-muted">
                        Gestiona tu experiencia profesional.
                    </p>

                    <a asp-area="Admin" asp-controller="Experiences" asp-action="Index" class="btn btn-primary">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Mensajes</h2>
                    <p class="text-muted">
                        Revisa los mensajes de contacto.
                    </p>

                    <a asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" class="btn btn-primary">
                        Ver mensajes
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>