@model PagedResultViewModel<ContactMessageAdminViewModel>

@{
    ViewData["Title"] = "Mensajes de contacto";
}

<div class="container py-5">
    <div class="mb-4">
        <h1>Mensajes de contacto</h1>
        <p class="text-muted">
            Revisa los mensajes enviados desde el portafolio.
        </p>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">
            No hay mensajes registrados.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Estado</th>
                            <th>Nombre</th>
                            <th>Asunto</th>
                            <th>Fecha</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var message in Model.Items)
                        {
                            <tr class="@(!message.IsRead ? "table-warning" : string.Empty)">
                                <td>
                                    @if (message.IsRead)
                                    {
                                        <span class="badge text-bg-secondary">
                                            Leído
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-primary">
                                            Nuevo
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div>@message.Name</div>
                                    <small class="text-muted">
                                        @message.Email
                                    </small>
                                </td>

                                <td>@message.Subject</td>

                                <td>
                                    @message.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@message.Id" class="btn btn-sm btn-primary">
                                        Ver
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@message.Id" class="btn btn-sm btn-danger">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Paginación de mensajes">
                        <ul class="pagination justify-content-center">

                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" class="page-link">
                                    Anterior
                                </a>
                            </li>

                            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                                    <a asp-action="Index" asp-route-page="@pageNumber" class="page-link">
                                        @pageNumber
                                    </a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" class="page-link">
                                    Siguiente
                                </a>
                            </li>

                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
</div>