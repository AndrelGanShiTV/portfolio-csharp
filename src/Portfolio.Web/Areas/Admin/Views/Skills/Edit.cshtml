@model SkillViewModel

@{
    ViewData["Title"] = "Editar tecnología";
}

<div class="container py-5">
    <h1>Editar tecnología</h1>

    <form asp-area="Admin" asp-controller="Skills" asp-action="Edit" asp-route-id="@Model.Id" method="post"
          class="mt-4">

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger">
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>

            <input asp-for="Name" class="form-control" />

            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Guardar cambios
        </button>

        <a asp-area="Admin" asp-controller="Skills" asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>