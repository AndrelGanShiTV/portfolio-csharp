<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portfolio.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Portfolio.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Andres
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Inicio
                            </a>

                        </li>

                        <li class="nav-item">

                            <a asp-area="" asp-controller="Home" asp-action="Experience" class="nav-link">
                                Experiencia
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Home" asp-action="About">
                                Sobre mí
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Projects" asp-action="Index">
                                Proyectos
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Home" asp-action="Contact">
                                Contacto
                            </a>

                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-4 mt-5">

        <div class="container text-center text-muted">
            <p class="mb-0">
                © @DateTime.Now.Year Andres
            </p <small>
            Construido con C# y ASP.NET Core
        </small>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
