@model ExperienceViewModel

<div asp-validation-summary="ModelOnly" class="text-danger">
</div>

<div class="mb-3">
    <label asp-for="Company" class="form-label"></label>

    <input asp-for="Company" class="form-control" />

    <span asp-validation-for="Company" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Position" class="form-label"></label>

    <input asp-for="Position" class="form-control" />

    <span asp-validation-for="Position" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>

    <textarea asp-for="Description" class="form-control" rows="5"></textarea>

    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="StartDate" class="form-label"></label>

        <input asp-for="StartDate" class="form-control" />

        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="EndDate" class="form-label"></label>

        <input asp-for="EndDate" class="form-control" id="end-date" />

        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="IsCurrent" class="form-check-input" id="is-current" />

    <label asp-for="IsCurrent" class="form-check-label"></label>
</div>

<div class="mb-3">
    <label asp-for="DisplayOrder" class="form-label"></label>

    <input asp-for="DisplayOrder" class="form-control" />

    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isCurrentCheckbox = document.getElementById("is-current");
        const endDateInput = document.getElementById("end-date");

        function updateEndDateState() {
            const isCurrent = isCurrentCheckbox.checked;

            endDateInput.disabled = isCurrent;

            if (isCurrent) {
                endDateInput.value = "";
            }
        }

        isCurrentCheckbox.addEventListener(
            "change",
            updateEndDateState
        );

        updateEndDateState();
    });
</script>