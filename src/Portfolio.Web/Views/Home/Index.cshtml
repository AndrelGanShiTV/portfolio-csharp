@{
    ViewData["Title"] = "Inicio";
}

<section class="container py-5">

    <div class="row align-items-center min-vh-75">

        <div class="col-lg-8">

            <span class="badge text-bg-primary mb-3">
                FullStack Developer
            </span>

            <h1 class="display-2 fw-bold">
                Hola, soy Andres.
            </h1>

            <p class="lead mt-3">
                Desarrollo aplicaciones web y soluciones
                digitales utilizando C#, ASP.NET Core
                y tecnologías modernas.
            </p>

            <div class="mt-4">

                <a asp-controller="Projects" asp-action="Index" class="btn btn-primary btn-lg me-2">
                    Ver proyectos
                </a>

                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary btn-lg">
                    Contactarme
                </a>

            </div>

        </div>

    </div>

</section>