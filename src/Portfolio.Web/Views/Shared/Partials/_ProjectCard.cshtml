@model ProjectCardViewModel

<div class="col-md-6 col-lg-4">

    <div class="card h-100">

        <div class="card-body d-flex flex-column">

            <h5 class="card-title">
                @Model.Name
            </h5>

            <p class="card-text">
                @Model.Description
            </p>

            <div class="mb-3">

                @foreach (var technology in Model.Technologies)
                {
                    <span class="badge text-bg-secondary me-1">
                        @technology
                    </span>
                }

            </div>

            <div class="mt-auto">

                <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">

                    Ver proyecto

                </a>

                @if (!string.IsNullOrWhiteSpace(Model.RepositoryUrl))
                {
                    <a href="@Model.RepositoryUrl" target="_blank" class="btn btn-outline-dark">

                        GitHub

                    </a>
                }

                <a asp-controller="Projects" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">

                    Editar

                </a>

                <a asp-controller="Projects" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">

                    Eliminar

                </a>

            </div>

        </div>

    </div>

</div>