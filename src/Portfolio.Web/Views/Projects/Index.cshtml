@model IEnumerable<ProjectCardViewModel>

@{
    ViewData["Title"] = "Proyectos";
}

<div class="container py-5">

    <div class="mb-5">

        <h1 class="display-5 fw-bold">
            Mis proyectos
        </h1>

        <p class="lead">
            Algunos proyectos y soluciones en los que he trabajado.
        </p>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Aún no hay proyectos publicados.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var project in Model)
            {
                <partial name="Partials/_ProjectCard" model="project" />
            }

        </div>
    }

</div>